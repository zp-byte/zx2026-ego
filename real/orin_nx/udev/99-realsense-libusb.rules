## Version: v1.0 (2026-10-09)
## Intel RealSense D4xx libusb udev rules —— 非 root 用户可读相机
## 来源：Intel realsense2_camera 官方 99-realsense-libusb.rules（D435 相关行 +
## 通用 USB 段）。安装：sudo cp 本文件 /etc/udev/rules.d/ && sudo udevadm
## control --reload-rules && 拔插相机。
## zx2026 红线：error-71 断流=接触不良（换口定谳）——udev 只解决权限，不解决
## 接触；断流先查物理口位（USB3 直插禁 hub）。

# Intel RealSense D435 / D435i
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b07", MODE:="0666", GROUP:="plugdev"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b0c", MODE:="0666", GROUP:="plugdev"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3d", MODE:="0666", GROUP:="plugdev"
# Intel RealSense D415
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0ad3", MODE:="0666", GROUP:="plugdev"
# Intel RealSense D415/D435 CDC（串口固件升级通道）
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="abef", MODE:="0666", GROUP:="plugdev"
# Intel RealSense Tracking T26x
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b37", MODE:="0666", GROUP:="plugdev"
# Intel RealSense 通用段（兜底：其余 8086 视频设备）
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{bDeviceClass}=="ef", ATTRS{bDeviceSubClass}=="02", ATTRS{bDeviceProtocol}=="01", MODE:="0666", GROUP:="plugdev"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{bDeviceClass}=="ef", ATTRS{bDeviceSubClass}=="02", ATTRS{bDeviceProtocol}=="02", MODE:="0666", GROUP:="plugdev"
KERNEL=="iwlwifi", MODE:="0660", GROUP:="video"
