<launch>
  <!-- ==================================================================
       camera_down.launch — WHEELTEC C100 下视 RGB 驱动档（2026-10-10 定谳）
       ==================================================================
       归属定谳：D435 是前视导航相机（VINS infra 双目 + 深度避障同一颗
       nodelet），一颗刚体相机不能兼作下视（斜装折中会把 z*tan(theta)
       系统误差注入对齐换算）。下视 RGB 由独立 C100 承担。C100 为 UVC
       免驱标准件，驱动走 usb_cam（本机未预装，install_deps.sh 已补）。

       节点名定 camera_down ⇒ 话题 /camera_down/image_raw 与
       /camera_down/camera_info（usb_cam 相对名随节点名前缀）。
       **禁复用 D435 的 /camera/color/image_raw**：两发布者同话题混流
       （前视 15Hz + 下视 30Hz 交错）= 静默灾难。

       现场装订四件：
         1. video_device  默认 /dev/camera_down（udev 稳定软链；规则模板
            udev/99-camera-down.rules 须用 lsusb 实测 VID:PID 填好装订）
         2. 分辨率/帧率   默认 640x480@30 yuyv（检测够用且省 CPU）；
            改分辨率必重标 min_blob_area_px（sim 320x240 标定值不作数）
         3. vfov          real_fleet.launch 的 camera_vfov_deg（解析式
            回退内参用；标定后填 camera_info_url 走精确档自动接管）
         4. align_axes    C100 装机朝向定轴：贴色块前推看质心 v 走向，
            顶边朝机头=top_fwd / 底边朝机头=bottom_fwd（接反=伺服反向
            推离色盘；旧名 d435_down/sim 仍兼容）
       -->
  <arg name="video_device" default="/dev/camera_down"/>
  <arg name="image_width" default="640"/>
  <arg name="image_height" default="480"/>
  <arg name="pixel_format" default="yuyv"/>
  <arg name="framerate" default="30"/>
  <arg name="io_method" default="mmap"/>
  <arg name="camera_name" default="camera_down"/>
  <arg name="camera_frame_id" default="camera_down_optical_frame"/>
  <arg name="camera_info_url" default=""/>

  <node pkg="usb_cam" type="usb_cam_node" name="camera_down" output="screen">
    <param name="video_device" value="$(arg video_device)"/>
    <param name="image_width" value="$(arg image_width)"/>
    <param name="image_height" value="$(arg image_height)"/>
    <param name="pixel_format" value="$(arg pixel_format)"/>
    <param name="framerate" value="$(arg framerate)"/>
    <param name="io_method" value="$(arg io_method)"/>
    <param name="camera_name" value="$(arg camera_name)"/>
    <param name="camera_frame_id" value="$(arg camera_frame_id)"/>
    <param name="camera_info_url" value="$(arg camera_info_url)"/>
  </node>
</launch>
