                                <bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD"/>
                            </instance_material>
                            <instance_material symbol="material5" target="#material5">
                                <bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD"/>
                            </instance_material>
                            <instance_material symbol="material6" target="#material6">
