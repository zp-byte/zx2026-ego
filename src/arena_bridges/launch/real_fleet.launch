<launch>
  <!-- =============================================================================
       real_fleet.launch — 真机单机注入栈（2026-09-26，每机一份，id 参数各机不同）
       =============================================================================
       定位：三桥一芯的"桥+芯"编排。官方栈由 Diff-planner 的 sh_files 拉起，
       不在本文件管辖。双档位（2026-10-09 换 VINS 定夺）：
         VIO 主档（本文件默认）：mavros + realsense(D435 infra 双目) + VINS
           + px4ctrl(run_ctrl_vio.launch)——前置判据：
           rostopic hz /vins/imu_propagate 活（VINS 已初始化）
         LIO 备档（一条命令回退）：odom_src:=/ekf/ekf_odom
           cloud_src:=/laserMapping/cloud_registered cloud_frame:=world
       链路（全部 sim 同码零改动，只换输入源）：
         /vins/imu_propagate（VINS world，重力对齐，原点=VINS 初始化点）
           ├─ odom_tf → /drone_<id>/odom（ENU；nav/mission/agent 消费）
           ├─ cloud_adapter（四道滤+同帧变换）→ /drone_<id>/cloud
           └─ vel_bridge（vel_cmd ENU→局部系逆变换）→ /setpoints_cmd（px4ctrl；
              run_ctrl_lio.launch ~cmd remap 定谳 2026-09-27——px4ctrl 实际订
              /setpoints_cmd，官方 traj_server 同此名；vel_bridge 默认
              /position_cmd 是历史误记，已在本 launch 显式指定 out 纠偏）
         hub fleet 下行 → gcs_agent（fleet-bridge 开关）→ /drone_<id>/odom_from_<s>
         mission_loader → /zx2026/mission/<id>（人工指派装订）
       部署三件套（拷机载后零代码改动）：
         ① settings_real.yaml → zx2026_common/config/sim_settings.yaml（覆盖）
         ② missions.yaml / profile_real_lio.yaml → tools/gcs/（各机拷贝改 ids；
            仅 1 号机 profile 保留 topics.stage，其余机删 stage 键让 fleet 回声接管）
         ③ catkin build（本包 arena_bridges 参与编入 devel）
       首飞限速：max_vel 保持 1.2 保守档（settings_real closed_loop.max_vel 同步）。
  -->
  <arg name="id" default="0"/>
  <arg name="yaw0_deg" default="0.0" doc="LIO 系 x 轴相对场地 ENU 东向的安装偏角（odom_tf/cloud_adapter/vel_bridge 三桥同源参数）"/>
  <arg name="ex0" default="0.0" doc="场地 ENU 原点平移（东）"/>
  <arg name="ny0" default="0.0" doc="场地 ENU 原点平移（北）"/>
  <arg name="odom_src" default="/vins/imu_propagate" doc="VIO 主档=VINS IMU 传播高频 odom（换 VINS 定夺 2026-10-09；节点名 vins→相对名 imu_propagate 即此全名，与官方 run_ctrl_vio.launch 的 px4ctrl remap 逐字同源）。LIO 备档回退=odom_src:=/ekf/ekf_odom"/>
  <arg name="cloud_src" default="/camera/depth/color/points" doc="VIO 主档=D435 深度点云（不依赖 LIO 配准云；MID360/LIO 可不起）。LIO 备档=cloud_src:=/laserMapping/cloud_registered"/>
  <arg name="cloud_frame" default="camera" doc="VIO 主档=camera（D435 相机系云，经 odom 四元数重投影到 VINS world 再四道滤）。LIO 备档=cloud_frame:=world"/>
  <arg name="cam_tilt_deg" default="0.0" doc="D435 安装下俯角（度，下俯为正）；cloud_frame=camera 时生效"/>
  <arg name="cam_dx" default="0.0"/>
  <arg name="cam_dy" default="0.0"/>
  <arg name="cam_dz" default="0.0" doc="相机在机体系安装平移 (m)"/>
  <arg name="server" default="192.168.31.100:9870" doc="GCS hub 地址（遥测上行+fleet 下行）"/>
  <arg name="max_vel" default="1.2" doc="vel_bridge 限幅（首飞 1.2 保守档）"/>
  <arg name="missions" default="$(env HOME)/zx2026_ego_ws/tools/gcs/missions.yaml" doc="人工指派文件"/>
  <arg name="profile" default="$(env HOME)/zx2026_ego_ws/tools/gcs/profile_real_lio.yaml" doc="agent 档案（每机拷贝改 ids；stage 键见头部②）"/>
  <arg name="stage_local" default="false" doc="仅 1 号机置 true：本地跑全局阶段机；/zx2026/start 人工 rosservice call 触发"/>

  <!-- GPS 锚定返航 + RGB 对齐 + 投放桥（2026-10-09 真机包扩展） -->
  <arg name="gps_home" default="true" doc="GPS 记起飞点+返航目标修正（gps_home_node；mavros global_position 插件 stock px4.launch 全插件加载恒在跑）"/>
  <arg name="gps_home_mode" default="replace" doc="executor 返航 pad 修正档：replace=GPS 目标接管（场景 pad 未实测装订时正确档）/correct=距原 pad 超 max_corr_m 拒用"/>
  <arg name="gps_max_corr_m" default="5.0" doc="GPS 修正对场景 pad 的偏移告警/钳位（m）"/>
  <arg name="drop_align" default="true" doc="下视 RGB 视觉伺服对齐（drop_align_node；仅 camera:=true 时拉起）"/>
  <arg name="align_axes" default="top_fwd" doc="图像 v 轴朝向档（2026-10-10 正名）：top_fwd=顶边朝机头（旧名 d435_down 同义）/bottom_fwd=底边朝机头（旧名 sim 同义）——C100 装机后必核，接反=伺服反向"/>
  <arg name="align_plane_z" default="0.05" doc="色盘顶面高度（z_cam=odom_z-此值；真机平台实际顶面赛前核对装订）"/>
  <arg name="align_stale_s" default="0.6" doc="RGB 修正新鲜期（s），过期 executor 回退平台心"/>
  <arg name="drop_bridge" default="false" doc="投放执行桥开关（机构接入前保持 false=executor 停在 DROP 安全侧）"/>
  <arg name="drop_backend" default="serial" doc="auto=地面联调假应答（带弹飞行严禁）/serial=机构串口行协议"/>
  <arg name="drop_port" default="/dev/ttyUSB0" doc="投放机构串口设备"/>
  <arg name="drop_baud" default="115200" doc="投放机构串口波特率"/>
  <arg name="drop_wait_timeout_s" default="15.0" doc="DROP 态等 /payload/done 超时自愈（s；0=关）。真机默认 15s：桥不开/桥死/回执丢自动走与 done 同一返航出口（错峰爬升回家）——原位悬停等人工=电池与 GPS 窗口双耗。桥开着时 serial 回执亚秒级，15s=10 倍裕度；要人工全程裁决置 0"/>

  <!-- 桥 1：odom 变换 LIO 局部系→ENU，out 话题直接对上 nav 的 ns+/odom（省 remap） -->
  <node pkg="arena_bridges" type="odom_tf.py" name="odom_tf" output="screen"
        args="--id $(arg id) --odom $(arg odom_src) --out /drone_$(arg id)/odom
              --yaw0-deg $(arg yaw0_deg) --ex0 $(arg ex0) --ny0 $(arg ny0)"/>

  <!-- 桥 2：真云四道滤（地面滤最要害）+ 滤后同帧变换 → nav 建图输入 -->
  <node pkg="arena_bridges" type="cloud_adapter.py" name="cloud_adapter" output="screen"
        args="--id $(arg id) --src $(arg cloud_src) --odom $(arg odom_src)
              --yaw0-deg $(arg yaw0_deg) --ex0 $(arg ex0) --ny0 $(arg ny0)
              --frame $(arg cloud_frame) --cam-tilt-deg $(arg cam_tilt_deg)
              --cam-dx $(arg cam_dx) --cam-dy $(arg cam_dy)
              --cam-dz $(arg cam_dz)"/>

  <!-- 导航芯（sim 同码；真机版设置靠①的文件覆盖，非此处参数） -->
  <node pkg="arena_nav" type="nav_node.py" name="nav_node" output="screen">
    <param name="drone_id" value="$(arg id)"/>
  </node>

  <!-- 任务芯（sim 同码） -->
  <node pkg="arena_mission" type="mission_executor_node.py" name="executor" output="screen">
    <param name="drone_id" value="$(arg id)"/>
    <param name="gps_home_mode" value="$(arg gps_home_mode)"/>
    <param name="gps_max_corr_m" value="$(arg gps_max_corr_m)"/>
    <param name="align_stale_s" value="$(arg align_stale_s)"/>
    <param name="drop_wait_timeout_s" value="$(arg drop_wait_timeout_s)"/>
  </node>

  <!-- 任务指派装订（latched；指派文件人工维护，缺条目启动即失败不带错飞） -->
  <node pkg="arena_bridges" type="mission_loader.py" name="mission_loader" output="screen"
        args="--id $(arg id) --yaml $(arg missions)"/>

  <!-- 释放门二次确认（type_match，每机一份本实例只服务本机）：RECON LOCK 后
       AT_DROP 的放行由 match/result MATCH 驱动（位置门+箱色复核），TIMEOUT 走
       executor 重试链（回 EXECUTE 重扫）。sim 由 stack_nodes 全局单例跑，
       真机跨 master 必须每机本地跑一份——缺它 = AT_DROP 永不放行（残留
       审计 2026-09-26 抓出的部署缺口）。 -->
  <node pkg="arena_mission" type="type_match_node.py" name="type_match" output="screen"/>

  <!-- 识别线（camera:=true 时启用）：通用 HSV 检测器，进 Image 出
       /drone_<id>/detected/{color,type,confidence}（type_match 消费契约）。
       camera_topic 缺省已按 d435.launch 实发话题定谳（/camera/color/image_raw，
       节点无 ns；旧缺省 /drone_<id>/camera/image_raw 是死话题——侦察
       2026-10-09 抓出）。首飞无相机线保持 camera:=false，match 走
       TIMEOUT/参考指派 fallback（sim 同码）。 -->
  <arg name="camera" default="false" doc="下视识别线开关（C100 驱动 camera_down:=true 起后置 true）"/>
  <arg name="camera_topic" default="/camera_down/image_raw" doc="下视 C100 sensor_msgs/Image（usb_cam camera_down.launch 实发定谳 2026-10-10；**与 real_d435.launch 同名 arg 默认必须同值**——pass_all_args 会用它覆盖此处默认，selftest L4 对质）"/>
  <arg name="camera_vfov_deg" default="50.0" doc="C100 垂直视场角（解析式回退内参 f=(h/2)/tan(vfov/2)；规格书装订项，错 vfov=错米制偏移比例；标定后 camera_info 优先自动接管）"/>
  <node if="$(arg camera)" pkg="arena_sensor" type="color_detector_node.py"
        name="color_detector" output="screen">
    <param name="drone_id" value="$(arg id)"/>
    <param name="image_topic" value="$(arg camera_topic)"/>
  </node>

  <!-- GPS 锚定返航：起飞时记 home GPS（TAKEOFF 段窗口均值），DROP 段测
       est-gps 刚性偏移发 /home/enu 修正目标；executor RETURN 入场换 pad
       （判完成随 pad 跟随）。sim 无 mavros=恒 NO_FIX 静默待机零行为。
       漂移率现场评估用 tools/gps_lio_compare.py。 -->
  <node if="$(arg gps_home)" pkg="arena_bridges" type="gps_home_node.py"
        name="gps_home" output="screen" args="--id $(arg id)"/>

  <!-- 下视 RGB 视觉伺服对齐：色块质心像素误差→fx/fy+z 换 ENU 偏移→
       /align/corr；executor _drop_hold 重拉优先取新鲜修正，释放门不变
       （MATCH+nav arrived+tol）。仅 camera:=true 时有意义。输入=下视
       C100（camera_down.launch 实发话题）；vfov 走解析式回退内参。 -->
  <node if="$(eval arg('camera') and arg('drop_align'))"
        pkg="arena_bridges" type="drop_align_node.py" name="drop_align"
        output="screen"
        args="--id $(arg id) --image-topic $(arg camera_topic)
              --axes $(arg align_axes) --plane-z $(arg align_plane_z)
              --vfov-deg $(arg camera_vfov_deg)"/>

  <!-- 投放执行桥（RFL 立案缺口落地 2026-10-09）：payload/command(UInt8)
       → 机构 → payload/done(Bool)。缺桥=executor 停在 DROP（安全侧失败，
       不误投）——机构接入前保持 drop_bridge:=false。serial 档行协议
       "DROP <u8>\n"/"OK"（payload_bridge_node docstring），联调日对质固件。 -->
  <node if="$(arg drop_bridge)" pkg="arena_bridges" type="payload_bridge_node.py"
        name="payload_bridge" output="screen"
        args="--id $(arg id) --backend $(arg drop_backend)
              --port $(arg drop_port) --baud $(arg drop_baud)"/>


  <!-- 桥 3：vel_cmd→/setpoints_cmd（px4ctrl CMD_CTRL 档；断链 0.5s→HOLD 定点）。
       【2026-09-27 定谳】必须显式指定 out 话题 /setpoints_cmd：run_ctrl_lio.launch 把
       px4ctrl ~cmd remap 到该名（源码实锤），vel_bridge 默认 /position_cmd 是
       历史误记——不纠偏则注入打空、CMD_CTRL 永不生效（首飞级隐患）。 -->
  <node pkg="arena_bridges" type="vel_bridge.py" name="vel_bridge" output="screen"
        args="--id $(arg id) --odom $(arg odom_src) --yaw0-deg $(arg yaw0_deg)
              --max-vel $(arg max_vel) --out /setpoints_cmd"/>

  <!-- GCS 代理：遥测上行 + fleet 下行桥（邻机感知 odom_from_<s> 契约） -->
  <node pkg="arena_bridges" type="gcs_agent.py" name="gcs_agent" output="screen"
        args="--profile $(arg profile) --fleet-bridge"/>

  <!-- 全局阶段机（仅 1 号机；fleet 回声把 stage 发给其余机）。
       真机程序缺口（残留审计 2026-09-26）：/zx2026/fleet_ready 真机无供给方
       （sim 由 arena 栈发），P1_INIT 会卡死——起飞前须人工发一次
         rostopic pub /zx2026/fleet_ready std_msgs/Bool "data: true"
       ；P2→P3 靠 rosservice call /zx2026/start；他机 mission/phase 跨
       master 不可见，P3→P4 与 P4→DONE 由 phase_timeout 60s / time_limit
       1500s 超时兜底推进（executor 1Hz state 心跳保证晚到机不漏触发）。 -->
  <node if="$(arg stage_local)" pkg="arena_mission" type="stage_controller_node.py"
        name="stage_controller" output="screen"/>
</launch>
