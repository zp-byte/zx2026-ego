<launch>
  <!-- =============================================================================
       defop.launch — DeFoP 三节点推理链（深度补洞 -> seVAE 编码 -> CPN 规划）
       sim/真机同码；话题全部 /drone_<id>/ 绝对名（vel_bridge 契约）。
       运行环境：~/defop_env/bin/python（TF 2.4.1 + torch CPU）——python_exe
       arg 经 launch-prefix 指定解释器；脚本内另有 ROS dist-packages 自举兜底。
       真机：depth_in 改接 /camera/depth/image_rect_raw（16UC1 毫米同契约）。
       ============================================================================= -->
  <!-- 联锁要求（P3 定谳 2026-09-29，校验后修订）：defop 臂启用时必须配套
       sim_settings.yaml planner.source: defop。缺键后果=defop_cpn 恒静默
       （cpn_active 旗永为默认 False）、defop 臂静默失效跑成基线——不是
       双发布者混流（终端交接闸门后双写已从源头排除：cruise 归 cpn、
       terminal/出发窗归 nav，单写者恒成立）。tools/defop_ab_run.py 每
       cell 双键同帧装订=天然联锁。 -->
  <arg name="drone_id" default="0"/>
  <arg name="depth_in" default="/drone_$(arg drone_id)/depth/image_raw"
       doc="深度输入（16UC1 毫米）；P1 depth_sim_node 默认话题，真机可换 /camera/depth/image_rect_raw"/>
  <arg name="python_exe" default="$(env HOME)/defop_env/bin/python"
       doc="三节点解释器（TF/torch 所在的 venv）；调试可用 python3"/>
  <arg name="goal_source" default="topic" doc="topic | waypoint_file"/>
  <arg name="waypoint_file" default="" doc="goal_source=waypoint_file 时的 yaml 航点文件"/>

  <group ns="drone_$(arg drone_id)">
    <!-- 线程帽（2026-09-29 T3）：多机同机堆叠时防 TF 线程池超订阅；真机单机单架不受影响。
         6×3 节点同机叠加时各库限 1 线程，防止 OMP/OpenBLAS/MKL 各自拉满核数爆仓。 -->
    <env name="OMP_NUM_THREADS" value="1"/>
    <env name="OPENBLAS_NUM_THREADS" value="1"/>
    <env name="MKL_NUM_THREADS" value="1"/>

    <!-- 节点 1：深度补洞（无需 TF/torch，但统一 venv 解释器省心） -->
    <node pkg="defop_nav" type="defop_depth_fill.py" name="defop_depth_fill"
          output="screen" launch-prefix="$(arg python_exe)">
      <rosparam file="$(find defop_nav)/config/defop_nav.yaml" command="load"/>
      <param name="drone_id" value="$(arg drone_id)"/>
      <param name="in_topic" value="$(arg depth_in)"/>
    </node>

    <!-- 节点 2：seVAE 编码（torch, .pth） -->
    <node pkg="defop_nav" type="defop_vae_node.py" name="defop_vae"
          output="screen" launch-prefix="$(arg python_exe)">
      <rosparam file="$(find defop_nav)/config/defop_nav.yaml" command="load"/>
      <param name="drone_id" value="$(arg drone_id)"/>
      <param name="in_topic" value="/drone_$(arg drone_id)/depth/image_filled"/>
    </node>

    <!-- 节点 3：CPN 碰撞预测 + 几何监督 + 死端逃逸（TF, hdf5 x3） -->
    <node pkg="defop_nav" type="defop_cpn_node.py" name="defop_cpn"
          output="screen" launch-prefix="$(arg python_exe)">
      <rosparam file="$(find defop_nav)/config/defop_nav.yaml" command="load"/>
      <param name="drone_id" value="$(arg drone_id)"/>
      <param name="goal_source" value="$(arg goal_source)"/>
      <param name="waypoint_file" value="$(arg waypoint_file)"/>
    </node>
  </group>
</launch>
